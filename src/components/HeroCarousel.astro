---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import photos from '../assets/carousel-photos.json';
import * as styles from '../styles/site';
interface Props {
  image: ImageMetadata;
  alt: string;
}
const { image, alt } = Astro.props;
const optimized = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/optimized/*.webp',
  { eager: true },
);
const sources = [
  { image, alt },
  ...photos.map((photo) => ({
    image: optimized[`../assets/optimized/${photo.name}.webp`].default,
    alt: photo.alt,
  })),
];
const slides = await Promise.all(
  sources.map(async ({ image, alt }) => {
    const variants = await Promise.all(
      [480, 800, 1200].map((width) =>
        getImage({
          src: image,
          width,
          height: (width * 3) / 4,
          fit: 'cover',
          format: 'webp',
          quality: 80,
        }),
      ),
    );
    return {
      src: variants[1].src,
      srcset: variants
        .map((variant, i) => `${variant.src} ${[480, 800, 1200][i]}w`)
        .join(', '),
      alt,
    };
  }),
);
const first = slides[0];
---

<hero-carousel class={styles.carousel} data-slides={JSON.stringify(slides)}>
  <section aria-label="Paddle photos" aria-roledescription="carousel">
    <div
      data-slide
      role="group"
      aria-roledescription="slide"
      aria-label="1 of 1"
    >
      <img
        class={styles.carouselPhoto}
        src={first.src}
        srcset={first.srcset}
        sizes="(min-width: 1200px) 610px, (min-width: 768px) 55vw, 100vw"
        alt={first.alt}
        width="1200"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        draggable="false"
      />
    </div>
    <div class={styles.carouselControls}>
      <div data-controls hidden>
        <button type="button" data-previous aria-label="Previous photo">
          <span aria-hidden="true">←</span>
        </button>
        <span data-counter aria-hidden="true">
          1 / 6
        </span>
        <button type="button" data-next aria-label="Next photo">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
    <p
      data-announcement
      class={styles.srOnly}
      role="status"
      aria-atomic="true"
    ></p>
  </section>
</hero-carousel>

<script>
  import '../scripts/hero-carousel';
</script>
