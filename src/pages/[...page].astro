---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { pageRoutes } from '../lib/content';
import * as styles from '../styles/site';
export async function getStaticPaths() {
  const routes = pageRoutes(await getCollection('pages'));
  if (!routes.some(({ path }) => path === '/'))
    throw new Error('A published home.md is required');
  return routes.map(({ entry, path }) => ({
    params: { page: path === '/' ? undefined : path.slice(1, -1) },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'pages'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Site title={entry.data.title} description={entry.data.description}>
  <section class={entry.data.hero ? styles.hero : styles.pageHeader}>
    <div>
      {entry.data.eyebrow && <p class={styles.eyebrow}>{entry.data.eyebrow}</p>}
      <h1 class={styles.title}>{entry.data.title}</h1>
      <p class={styles.intro}>{entry.data.description}</p>
    </div>
    {entry.data.hero &&
      (entry.id === 'home' ? (
        <HeroCarousel image={entry.data.hero.image} alt={entry.data.hero.alt} />
      ) : (
        <Image
          class={styles.photo}
          src={entry.data.hero.image}
          alt={entry.data.hero.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 55vw, 100vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      ))}
  </section>
  <article class={styles.prose}>
    <Content />
  </article>
</Site>
