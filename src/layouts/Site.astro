---
import { getCollection } from 'astro:content';
import { navigation, publishedPosts } from '../lib/content';
import * as styles from '../styles/site';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const links = navigation(await getCollection('pages'));
if (publishedPosts(await getCollection('posts')).length)
  links.push({ label: 'Blog', path: '/blog/' });
const canonical = new URL(
  noindex ? '/404.html' : Astro.url.pathname,
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Good Paddle</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <script is:inline src="/verdant-theme-toggle.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class={styles.shell}>
      <header class={styles.header}>
        <a class={styles.brand} href="/" aria-label="Good Paddle home">
          Good ❖ Paddle
        </a>
        <nav aria-label="Main navigation" class={styles.nav}>
          {links.map((link) => (
            <a
              href={link.path}
              aria-current={
                Astro.url.pathname === link.path ? 'page' : undefined
              }
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class={styles.footer}>
        <p>Good Paddle · Time well spent on the water.</p>
        <fieldset class={styles.theme}>
          <legend>Appearance</legend>
          {['system', 'light', 'dark'].map((value) => (
            <label>
              <input
                type="radio"
                name="theme-preference"
                value={value}
                checked={value === 'system'}
              />
              {value[0].toUpperCase() + value.slice(1)}
            </label>
          ))}
        </fieldset>
      </footer>
    </div>
  </body>
</html>
