{
  "name": "goodpaddle",
  "version": "0.0.1",
  "description": "Website for GoodPaddle.com",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:styles && astro dev",
    "start": "npm run dev",
    "prepare:styles": "panda codegen && node scripts/copy-theme.mjs",
    "build": "npm run prepare:styles && astro build",
    "preview": "astro preview",
    "check": "npm run prepare:styles && astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run lint && npm run format:check && npm run check && npm run test:coverage && npm run build && npm run check:site && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ivanoats/goodpaddle.git"
  },
  "keywords": [
    "website",
    "SUP",
    "paddle",
    "ivanoats"
  ],
  "author": "Ivan Storck",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/ivanoats/goodpaddle/issues"
  },
  "homepage": "https://github.com/ivanoats/goodpaddle#readme",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@pandacss/dev": "2.1.2",
    "@pandacss/preset-base": "2.1.2",
    "@pandacss/preset-panda": "2.1.2",
    "@playwright/test": "1.63.0",
    "@sustainablewebsites/verdant-design": "0.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "astro": "7.3.6",
    "cheerio": "1.2.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  }
}
